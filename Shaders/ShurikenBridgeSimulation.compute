#pragma kernel CSResetParticleIndirectArgs
#pragma kernel CSSimulateAndCullParticles
#pragma kernel CSBuildUnityParticleInstanceData

// 256-Byte (16 x float4) strictly 16-byte aligned Emitter Descriptor
struct GpuEmitterDescriptor
{
    // Row 0 (16B)
    float3 WorldPosition;
    uint MaterialBucketIndex;

    // Row 1 (16B)
    float4 WorldRotationQuat;

    // Row 2 (16B)
    float3 WorldScale;
    uint ActiveParticleCount;

    // Row 3 (16B)
    float Duration;
    float StartDelay;
    float StartLifetimeMin;
    float StartLifetimeMax;

    // Row 4 (16B)
    float StartSpeedMin;
    float StartSpeedMax;
    float SimulationSpeed;
    float GravityModifier;

    // Row 5 (16B)
    float3 StartSizeMin3D;
    float StartSizeMaxRatio;

    // Row 6 (16B)
    float3 StartRotationMin3D;
    float StartRotationMaxZ;

    // Row 7 (16B)
    uint Flags0;
    uint Flags1;
    uint RandomSeed;
    float EmitterStartTime;

    // Row 8 (16B)
    float ShapeRadius;
    float ShapeAngleRad;
    float ShapeRadiusThickness;
    float ShapeDonutRadius;

    // Row 9 (16B)
    float3 ShapeBoxScale;
    float DragDamping;

    // Row 10 (16B)
    float3 ShapeLocalOffset;
    float NoiseStrength;

    // Row 11 (16B)
    float3 LinearVelocityAndForce;
    float RadialAndOrbitalSwirl;

    // Row 12 (16B)
    uint StartColorMinPacked;
    uint StartColorMaxPacked;
    float NoiseFrequency;
    float ExternalForceMultiplier;

    // Row 13 (16B)
    float BurstTime;
    float BurstRepeatInterval;
    float BurstCycleCount;
    float SpeedRangeMin;

    // Row 14 (16B)
    float SpeedRangeMax;
    float CollisionBounce;
    float CollisionDampen;
    float CollisionLifetimeLoss;

    // Row 15 (16B)
    float4 PrimaryCollisionPlane; // xyz = Unit Normal, w = Plane Distance (-dot(N, P0))
};

// 64-Byte (4 x float4) strictly 16-byte aligned Visible Particle Instance
struct GpuVisibleParticle
{
    float4 PositionAndSizeX;    // xyz: World Position, w: Scale X
    float4 VelocityAndRotZ;     // xyz: World Velocity, w: Rotation Z (radians)
    float4 ColorAndAlphaAge;    // rgb: Linear HDR Color, a: floor(normAge * 255) + clamp(alpha, 0.001, 0.999)
    float4 ScaleYZAndRotXY;     // x: Scale Y, y: Scale Z, z: Rotation X (radians), w: Rotation Y (radians)
};

// 64-Byte (4 x float4) Read-Only External Force Field Descriptor (ParticleSystemForceField)
struct GpuForceFieldDescriptor
{
    float3 Position;
    float EndRange;

    float4 RotationQuat;

    float3 DirectionForce;
    float GravityStrength;

    float RotationSpeed;
    float DragStrength;
    float StartRange;
    float EnabledFlag;
};

// 56-Byte Unity Official Particle Instancing Struct (Matches URP ParticlesInstancing.hlsl 1:1)
struct DefaultParticleInstanceData
{
    float3x4 transform; // 48 Bytes (3 rows x 4 columns: Right, Up, Forward, WorldPosition)
    uint color;         // 4 Bytes (R8G8B8A8 packed color read by GetParticleColor -> UnpackFromR8G8B8A8)
    float animFrame;    // 4 Bytes (Flipbook sheet frame index read by GetParticleTexcoords)
};

// Read-Only SRVs (0 UAV cost)
StructuredBuffer<GpuEmitterDescriptor> _EmittersBuffer;
StructuredBuffer<GpuForceFieldDescriptor> _ForceFieldsBuffer;
StructuredBuffer<float4> _CollisionPlanesBuffer; // 6 planes per emitter slot (emitterIdx * 6 + p)
Texture2D<float4> _CurveGradientLutTex;          // 64 x 512 RGBAHalf (4 rows per profile)

// Write UAVs (Strictly <= 2 UAVs per kernel -> 100% compliant with OpenGL ES 3.1 / Metal / Vulkan / DX11 / DX12)
RWStructuredBuffer<GpuVisibleParticle> _VisibleParticlesBuffer;
RWStructuredBuffer<uint> _IndirectArgsBuffer;

// Kernel 2 Output UAV for Standard Unity / User Custom Shaders (unity_ParticleInstanceData)
RWStructuredBuffer<DefaultParticleInstanceData> _TargetUnityParticleBuffer;

uint _EmitterCount;
uint _ParticlesPerEmitter;
uint _CommandCount;
uint _MaxInstancesPerCommand;
uint _ForceFieldCount;
float _GlobalTime;
uint _EnableFrustumCulling;
uint _EnableGpuLod;
float4 _CameraWorldPos;
float4 _LodDistanceSqThresholds; // x = LOD0->LOD1 dist^2, y = LOD1->LOD2 dist^2, z = MaxCullDist^2
float4 _CameraFrustumPlanes[6];

// Kernel 2 Per-Command Conversion Uniforms
uint _SourceCommandIndex;
uint _BucketRenderShape;        // 0 = Billboard, 1 = StretchedBillboard, 2 = MeshSphere, 3 = MeshCube/CustomMesh
float4 _BucketStretchAndFlipbook; // x = StretchMultiplier, y = MaxStretchRatio, z = TotalFlipbookFrames

uint PcgHash(uint input)
{
    uint state = input * 747796405u + 2891336453u;
    uint word = ((state >> ((state >> 28u) + 4u)) ^ state) * 277803737u;
    return (word >> 22u) ^ word;
}

float Hash01(uint seed)
{
    return (PcgHash(seed) & 0x00FFFFFFu) * (1.0 / 16777215.0);
}

float3 HashUnitVector3(uint seed)
{
    float z = Hash01(seed) * 2.0 - 1.0;
    float a = Hash01(seed + 19937u) * 6.28318530718;
    float r = sqrt(max(0.0, 1.0 - z * z));
    float s, c;
    sincos(a, s, c);
    return float3(r * c, z, r * s);
}

float4 UnpackRGBA8(uint packedColor)
{
    float r = ((packedColor >> 0u) & 0xFFu) * (1.0 / 255.0);
    float g = ((packedColor >> 8u) & 0xFFu) * (1.0 / 255.0);
    float b = ((packedColor >> 16u) & 0xFFu) * (1.0 / 255.0);
    float a = ((packedColor >> 24u) & 0xFFu) * (1.0 / 255.0);
    return float4(r, g, b, a);
}

uint PackRGBA8(float4 color)
{
    uint r = (uint)clamp(color.r * 255.0 + 0.5, 0.0, 255.0);
    uint g = (uint)clamp(color.g * 255.0 + 0.5, 0.0, 255.0);
    uint b = (uint)clamp(color.b * 255.0 + 0.5, 0.0, 255.0);
    uint a = (uint)clamp(color.a * 255.0 + 0.5, 0.0, 255.0);
    return r | (g << 8u) | (b << 16u) | (a << 24u);
}

float3 RotateByQuaternion(float3 v, float4 q)
{
    float3 t = 2.0 * cross(q.xyz, v);
    return v + q.w * t + cross(q.xyz, t);
}

float3x3 BuildEulerRotationMatrix3x3(float3 eulerRad)
{
    float sx, cx, sy, cy, sz, cz;
    sincos(eulerRad.x, sx, cx);
    sincos(eulerRad.y, sy, cy);
    sincos(eulerRad.z, sz, cz);

    // Unity ZXY Euler convention
    float3 col0 = float3(cy * cz + sy * sx * sz, cx * sz, -sy * cz + cy * sx * sz);
    float3 col1 = float3(-cy * sz + sy * sx * cz, cx * cz, sy * sz + cy * sx * cz);
    float3 col2 = float3(sy * cx, -sx, cy * cx);
    return float3x3(col0, col1, col2);
}

float3 SampleTurbulenceField(float3 p, float time, float freq)
{
    float3 q = p * freq + float3(time * 0.7, time * 1.1, time * 0.5);
    float nx = sin(q.y * 1.7 + cos(q.z * 1.3 + time));
    float ny = cos(q.z * 1.5 + sin(q.x * 1.9 - time * 0.8));
    float nz = sin(q.x * 1.3 - cos(q.y * 1.7 + time * 0.6));
    return float3(nx, ny, nz);
}

// 2-Tap Linear Interpolated LUT Fetch using Texture2D.Load (no SamplerState required across APIs)
float4 SampleLutRow(int rowY, float t)
{
    float coord = saturate(t) * 63.0;
    int x0 = (int)floor(coord);
    int x1 = min(x0 + 1, 63);
    float fracX = coord - (float)x0;
    float4 v0 = _CurveGradientLutTex.Load(int3(x0, rowY, 0));
    float4 v1 = _CurveGradientLutTex.Load(int3(x1, rowY, 0));
    return lerp(v0, v1, fracX);
}

// Analytical Quadratic Plane Impact Solver: solves dot(N, p0 + v0*t + 0.5*a*t^2) + d - radius = 0
bool SolveAnalyticalPlaneHit(float3 p0, float3 v0, float3 acc, float4 plane, float radius, float maxT, out float outHitT)
{
    outHitT = maxT + 1.0;
    float3 n = plane.xyz;
    float s0 = dot(n, p0) + plane.w - radius;
    float vn = dot(n, v0);
    float an = dot(n, acc);

    // If already below/on plane and moving into plane, hit immediately
    if (s0 <= 0.0 && vn < -0.001)
    {
        outHitT = 0.0005;
        return true;
    }

    if (abs(an) < 0.0001)
    {
        // Linear motion relative to plane (e.g. vertical wall)
        if (vn < -0.0001 && s0 > 0.0)
        {
            float tHit = -s0 / vn;
            if (tHit > 0.0005 && tHit < maxT)
            {
                outHitT = tHit;
                return true;
            }
        }
        return false;
    }

    // Quadratic: 0.5*an*t^2 + vn*t + s0 = 0
    float A = 0.5 * an;
    float B = vn;
    float C = s0;
    float disc = B * B - 4.0 * A * C;
    if (disc < 0.0)
    {
        return false;
    }

    float sqrtDisc = sqrt(disc);
    float inv2A = 1.0 / (2.0 * A);
    float t1 = (-B - sqrtDisc) * inv2A;
    float t2 = (-B + sqrtDisc) * inv2A;

    float bestT = maxT + 1.0;
    if (t1 > 0.0005 && t1 < bestT)
    {
        float vAtHit = vn + an * t1;
        if (vAtHit < 0.0) bestT = t1;
    }
    if (t2 > 0.0005 && t2 < bestT)
    {
        float vAtHit = vn + an * t2;
        if (vAtHit < 0.0) bestT = t2;
    }

    if (bestT < maxT)
    {
        outHitT = bestT;
        return true;
    }
    return false;
}

[numthreads(16, 1, 1)]
void CSResetParticleIndirectArgs(uint3 id : SV_DispatchThreadID)
{
    uint cmdIdx = id.x;
    if (cmdIdx < _CommandCount)
    {
        _IndirectArgsBuffer[cmdIdx * 5u + 1u] = 0u;
    }
}

[numthreads(64, 1, 1)]
void CSSimulateAndCullParticles(uint3 id : SV_DispatchThreadID)
{
    uint globalIdx = id.x;
    uint emitterIdx = globalIdx / _ParticlesPerEmitter;
    if (emitterIdx >= _EmitterCount)
    {
        return;
    }

    uint localParticleIdx = globalIdx - (emitterIdx * _ParticlesPerEmitter);
    GpuEmitterDescriptor emitter = _EmittersBuffer[emitterIdx];
    if (localParticleIdx >= emitter.ActiveParticleCount)
    {
        return;
    }

    uint flags0 = emitter.Flags0;
    uint flags1 = emitter.Flags1;

    bool isLooping = (flags0 & (1u << 0)) != 0u;
    bool useLocalSpace = (flags0 & (1u << 1)) != 0u;
    bool isPrewarm = (flags0 & (1u << 2)) != 0u;
    bool noiseEnabled = (flags0 & (1u << 3)) != 0u;
    bool distanceThinning = (flags0 & (1u << 5)) != 0u;
    bool collapseLodToCmd0 = (flags0 & (1u << 6)) != 0u;
    bool collisionEnabled = (flags0 & (1u << 7)) != 0u;
    bool externalForcesEnabled = (flags0 & (1u << 8)) != 0u;
    bool colorBySpeedEnabled = (flags0 & (1u << 9)) != 0u;
    bool sizeBySpeedEnabled = (flags0 & (1u << 10)) != 0u;
    bool rotationBySpeedEnabled = (flags0 & (1u << 11)) != 0u;
    bool startSize3D = (flags0 & (1u << 12)) != 0u;
    bool startRotation3D = (flags0 & (1u << 13)) != 0u;

    uint baseSeed = emitter.RandomSeed ^ (emitterIdx * 747796405u + localParticleIdx * 2891336453u);
    float life = lerp(emitter.StartLifetimeMin, emitter.StartLifetimeMax, Hash01(baseSeed + 1u));
    life = max(life, 0.05);

    float simSpeed = max(0.0, emitter.SimulationSpeed);
    float emitterTime = (_GlobalTime - emitter.EmitterStartTime) * simSpeed - emitter.StartDelay;
    if (isPrewarm && isLooping)
    {
        emitterTime += max(emitter.Duration, life);
    }

    if (emitterTime < 0.0)
    {
        return;
    }

    // Separate Continuous RateOverTime slots vs Synchronized Multi-Burst slots
    uint burstCount = (flags1 >> 16u) & 0xFFu;
    uint rateSlots = (emitter.ActiveParticleCount > burstCount) ? (emitter.ActiveParticleCount - burstCount) : 0u;
    bool isBurstParticle = (burstCount > 0u) && (localParticleIdx >= rateSlots);

    float age = 0.0;
    uint cycleIdx = 0u;

    if (isBurstParticle)
    {
        float burstElapsed = emitterTime - emitter.BurstTime;
        if (burstElapsed < 0.0)
        {
            return;
        }

        float interval = (emitter.BurstRepeatInterval > 0.01) ? emitter.BurstRepeatInterval : max(emitter.Duration, life);
        float cycleFloat = floor(burstElapsed / interval);
        cycleIdx = (uint)max(0.0, cycleFloat);

        if (!isLooping && emitter.BurstCycleCount > 0.5 && cycleFloat >= emitter.BurstCycleCount)
        {
            return;
        }

        age = burstElapsed - cycleFloat * interval;
        if (age >= life)
        {
            return;
        }
    }
    else
    {
        float spawnPhase = ((float)localParticleIdx / max(1.0, (float)rateSlots)) * life;
        float elapsed = emitterTime - spawnPhase;
        if (elapsed < 0.0)
        {
            return;
        }

        if (!isLooping && elapsed >= emitter.Duration + life)
        {
            return;
        }

        float cycleFloat = floor(elapsed / life);
        cycleIdx = (uint)max(0.0, cycleFloat);
        if (!isLooping && cycleIdx > 0u && (cycleFloat * life + spawnPhase) > emitter.Duration)
        {
            return;
        }

        age = elapsed - cycleFloat * life;
    }

    uint cycleSeed = baseSeed ^ (cycleIdx * 1664525u + 1013904223u);

    // 1. Sample Emission Shape in Local Space (1:1 Unity Native Shuriken Axes: +Z forward for Cone/Hemisphere/Box, XY plane for Circle/Donut, +Y for Edge)
    uint shapeType = (flags0 >> 16u) & 0x0Fu;
    float3 localSpawnPos = float3(0.0, 0.0, 0.0);
    float3 localEmitDir = float3(0.0, 0.0, 1.0);

    float u1 = Hash01(cycleSeed + 3u);
    float u2 = Hash01(cycleSeed + 5u);
    float u3 = Hash01(cycleSeed + 7u);
    float thickness = saturate(emitter.ShapeRadiusThickness);

    if (shapeType == 0u) // Cone (Base disk in XY plane, emits along +Z)
    {
        float angle = u1 * 6.28318530718;
        float rNorm = lerp(1.0, sqrt(u2), thickness);
        float r = rNorm * emitter.ShapeRadius;
        float s, c;
        sincos(angle, s, c);
        localSpawnPos = float3(c * r, s * r, 0.0);

        float tanCone = tan(clamp(emitter.ShapeAngleRad, 0.0, 1.45));
        float2 spread = float2(c, s) * (rNorm * tanCone);
        localEmitDir = normalize(float3(spread.x, spread.y, 1.0));
    }
    else if (shapeType == 1u) // Sphere (3D radial outward)
    {
        float3 dir = HashUnitVector3(cycleSeed + 11u);
        localEmitDir = dir;
        float rNorm = lerp(1.0, pow(u1, 0.3333333), thickness);
        localSpawnPos = dir * (rNorm * emitter.ShapeRadius);
    }
    else if (shapeType == 2u) // Hemisphere (Dome pointing along +Z)
    {
        float3 dir = HashUnitVector3(cycleSeed + 13u);
        dir.z = abs(dir.z);
        localEmitDir = normalize(dir);
        float rNorm = lerp(1.0, pow(u1, 0.3333333), thickness);
        localSpawnPos = localEmitDir * (rNorm * emitter.ShapeRadius);
    }
    else if (shapeType == 3u) // Box (Emits along +Z)
    {
        localSpawnPos = (float3(u1, u2, u3) - 0.5) * emitter.ShapeBoxScale;
        localEmitDir = float3(0.0, 0.0, 1.0);
    }
    else if (shapeType == 4u) // Circle (Disk in XY plane, emits radially in XY)
    {
        float angle = u1 * 6.28318530718;
        float rNorm = lerp(1.0, sqrt(u2), thickness);
        float r = rNorm * emitter.ShapeRadius;
        float s, c;
        sincos(angle, s, c);
        localSpawnPos = float3(c * r, s * r, 0.0);
        localEmitDir = float3(c, s, 0.0);
    }
    else if (shapeType == 5u) // Edge (Segment along X, emits along +Y)
    {
        localSpawnPos = float3((u1 * 2.0 - 1.0) * emitter.ShapeRadius, 0.0, 0.0);
        localEmitDir = float3(0.0, 1.0, 0.0);
    }
    else // 6u: Donut (Torus ring in XY plane around Z axis, emits radially outward from tube)
    {
        float ringAngle = u1 * 6.28318530718;
        float tubeAngle = u2 * 6.28318530718;
        float tubeR = lerp(1.0, sqrt(u3), thickness) * max(0.01, emitter.ShapeDonutRadius);
        float sr, cr, st, ct;
        sincos(ringAngle, sr, cr);
        sincos(tubeAngle, st, ct);
        float3 ringDir = float3(cr, sr, 0.0);
        float3 tubeOffset = ringDir * (ct * tubeR) + float3(0.0, 0.0, st * tubeR);
        localSpawnPos = ringDir * emitter.ShapeRadius + tubeOffset;
        float tubeLen = length(tubeOffset);
        localEmitDir = (tubeLen > 0.0001) ? (tubeOffset / tubeLen) : ringDir;
    }

    localSpawnPos += emitter.ShapeLocalOffset;

    float3 worldSpawnPos = emitter.WorldPosition + RotateByQuaternion(localSpawnPos * emitter.WorldScale, emitter.WorldRotationQuat);
    float3 worldEmitDir = normalize(RotateByQuaternion(localEmitDir, emitter.WorldRotationQuat));

    // 2. Sample Curve & Gradient LUT (Over Lifetime)
    uint lutProfile = (flags0 >> 20u) & 0x7Fu;
    int lutBaseRow = (int)(lutProfile * 4u);
    float normAge = saturate(age / life);
    float4 lutColor = SampleLutRow(lutBaseRow + 0, normAge);
    float4 lutCurves = SampleLutRow(lutBaseRow + 1, normAge); // x: SizeMult, y: SpeedMult, z: RotZRate, w: NoiseMult

    // 3. Initial Velocity, Drag, Gravity, Linear Forces & Analytical Plane Collision (Up to 3 Bounces!)
    float startSpeed = lerp(emitter.StartSpeedMin, emitter.StartSpeedMax, Hash01(cycleSeed + 17u));
    float effectiveSpeed = startSpeed * max(0.05, lutCurves.y);
    float dragFactor = 1.0 / (1.0 + max(0.0, emitter.DragDamping) * age);
    float3 initialVel = worldEmitDir * (effectiveSpeed * dragFactor);

    float3 linearVelForce = useLocalSpace
        ? RotateByQuaternion(emitter.LinearVelocityAndForce, emitter.WorldRotationQuat)
        : emitter.LinearVelocityAndForce;
    float3 gravityAcc = float3(0.0, -9.81 * emitter.GravityModifier, 0.0);

    float3 startSizeVec = emitter.StartSizeMin3D * lerp(1.0, max(0.01, emitter.StartSizeMaxRatio), Hash01(cycleSeed + 23u));
    float approxRadius = max(startSizeVec.x, max(startSizeVec.y, startSizeVec.z)) * 0.45 * max(0.1, lutCurves.x);

    float3 worldPos;
    float3 worldVel;

    if (collisionEnabled)
    {
        uint planeCount = (flags1 >> 24u) & 0xFFu;
        float3 curPos = worldSpawnPos;
        float3 curVel = initialVel + linearVelForce;
        float remAge = age;
        float effectiveLife = life;

        // Analytical multi-bounce loop (up to 3 exact parabolic bounces, 0 PhysX CPU cost, 0 extra UAVs!)
        [unroll]
        for (int bounceIter = 0; bounceIter < 3; bounceIter++)
        {
            float earliestT = remAge + 1.0;
            float4 hitPlane = float4(0.0, 1.0, 0.0, 0.0);
            bool foundHit = false;

            if (planeCount <= 1u)
            {
                float tHit;
                if (SolveAnalyticalPlaneHit(curPos, curVel, gravityAcc, emitter.PrimaryCollisionPlane, approxRadius, remAge, tHit))
                {
                    earliestT = tHit;
                    hitPlane = emitter.PrimaryCollisionPlane;
                    foundHit = true;
                }
            }
            else
            {
                uint clampedPlanes = min(planeCount, 6u);
                for (uint p = 0u; p < clampedPlanes; p++)
                {
                    float4 pl = _CollisionPlanesBuffer[emitterIdx * 6u + p];
                    float tHit;
                    if (SolveAnalyticalPlaneHit(curPos, curVel, gravityAcc, pl, approxRadius, earliestT, tHit))
                    {
                        earliestT = tHit;
                        hitPlane = pl;
                        foundHit = true;
                    }
                }
            }

            if (!foundHit)
            {
                break;
            }

            // Advance to exact hit point & reflect velocity with Bounce and tangential Dampen
            curPos = curPos + curVel * earliestT + 0.5 * gravityAcc * (earliestT * earliestT);
            curVel = curVel + gravityAcc * earliestT;

            float3 n = hitPlane.xyz;
            float3 vNormal = dot(curVel, n) * n;
            float3 vTangent = curVel - vNormal;
            curVel = vTangent * saturate(1.0 - emitter.CollisionDampen) - vNormal * max(0.0, emitter.CollisionBounce);
            curPos += n * 0.002;
            remAge -= earliestT;

            effectiveLife -= life * saturate(emitter.CollisionLifetimeLoss);
            if (age >= effectiveLife)
            {
                return;
            }
        }

        worldPos = curPos + curVel * remAge + 0.5 * gravityAcc * (remAge * remAge);
        worldVel = curVel + gravityAcc * remAge;
        normAge = saturate(age / max(0.01, effectiveLife));
    }
    else
    {
        worldPos = worldSpawnPos
            + initialVel * age
            + linearVelForce * age
            + 0.5 * gravityAcc * (age * age);
        worldVel = initialVel + linearVelForce + gravityAcc * age;
    }

    // Orbital Swirl around emitter axis
    if (abs(emitter.RadialAndOrbitalSwirl) > 0.001)
    {
        float3 rel = worldPos - emitter.WorldPosition;
        float swirlAngle = emitter.RadialAndOrbitalSwirl * age;
        float s, c;
        sincos(swirlAngle, s, c);
        float2 rotatedXZ = float2(rel.x * c - rel.z * s, rel.x * s + rel.z * c);
        float3 swirlOffset = float3(rotatedXZ.x - rel.x, 0.0, rotatedXZ.y - rel.z);
        worldPos += swirlOffset;
        worldVel += float3(-rel.z, 0.0, rel.x) * emitter.RadialAndOrbitalSwirl;
    }

    // 3D Curl/Simplex Turbulence Noise
    if (noiseEnabled && emitter.NoiseStrength > 0.001)
    {
        float3 turb = SampleTurbulenceField(worldSpawnPos + worldPos * 0.35, _GlobalTime, max(0.1, emitter.NoiseFrequency));
        float turbAmp = emitter.NoiseStrength * lutCurves.w;
        worldPos += turb * (turbAmp * age * 0.65);
        worldVel += turb * turbAmp;
    }

    // 4. External Forces (Unity ParticleSystemForceField integration — Wind, Gravity Attractor/Repulsor, Vortex)
    if (externalForcesEnabled && _ForceFieldCount > 0u && abs(emitter.ExternalForceMultiplier) > 0.001)
    {
        float extMult = emitter.ExternalForceMultiplier;
        uint ffCount = min(_ForceFieldCount, 32u);
        for (uint f = 0u; f < ffCount; f++)
        {
            GpuForceFieldDescriptor ff = _ForceFieldsBuffer[f];
            if (ff.EnabledFlag < 0.5)
            {
                continue;
            }

            float3 rel = worldPos - ff.Position;
            float distSq = dot(rel, rel);
            float endSq = ff.EndRange * ff.EndRange;
            float startSq = ff.StartRange * ff.StartRange;

            if (distSq <= endSq && distSq >= startSq)
            {
                float dist = sqrt(max(0.0001, distSq));
                float falloff = saturate(1.0 - (dist - ff.StartRange) / max(0.001, ff.EndRange - ff.StartRange));
                float3 fieldForce = float3(0.0, 0.0, 0.0);

                // Directional wind force
                fieldForce += RotateByQuaternion(ff.DirectionForce, ff.RotationQuat);

                // Radial gravity attractor (+) / repulsor (-)
                if (abs(ff.GravityStrength) > 0.001)
                {
                    fieldForce += (-rel / dist) * ff.GravityStrength;
                }

                // Vortex rotation around field Up axis
                if (abs(ff.RotationSpeed) > 0.001)
                {
                    float3 fieldUp = RotateByQuaternion(float3(0.0, 1.0, 0.0), ff.RotationQuat);
                    fieldForce += cross(fieldUp, rel) * ff.RotationSpeed;
                }

                float3 appliedAcc = fieldForce * (falloff * extMult);
                worldPos += appliedAcc * (0.5 * age * age);
                worldVel += appliedAcc * age;
            }
        }
    }

    // 5. Color by Speed / Size by Speed / Rotation by Speed
    float instSpeed = length(worldVel);
    float speedT = saturate((instSpeed - emitter.SpeedRangeMin) / max(0.001, emitter.SpeedRangeMax - emitter.SpeedRangeMin));

    float4 speedColorMult = colorBySpeedEnabled ? SampleLutRow(lutBaseRow + 2, speedT) : float4(1.0, 1.0, 1.0, 1.0);
    float4 speedCurves = (sizeBySpeedEnabled || rotationBySpeedEnabled)
        ? SampleLutRow(lutBaseRow + 3, speedT)
        : float4(1.0, 0.0, 0.0, 0.0);

    float sizeSpeedMult = sizeBySpeedEnabled ? max(0.0, speedCurves.x) : 1.0;
    float rotSpeedAdd = rotationBySpeedEnabled ? speedCurves.y : 0.0;

    float3 currentSize3D = startSizeVec * max(0.0, lutCurves.x) * sizeSpeedMult;
    float maxAxisSize = max(currentSize3D.x, max(currentSize3D.y, currentSize3D.z));
    if (maxAxisSize <= 0.0005)
    {
        return;
    }

    // 6. 6-Plane GPU Frustum Culling
    if (_EnableFrustumCulling != 0u)
    {
        float cullRadius = maxAxisSize * 1.35;

        [unroll]
        for (int p = 0; p < 6; p++)
        {
            float4 plane = _CameraFrustumPlanes[p];
            if (dot(plane.xyz, worldPos) + plane.w < -cullRadius)
            {
                return;
            }
        }
    }

    // 7. GPU-Driven Distance LOD Routing (LOD 0 / LOD 1 / LOD 2) + Distance Density Thinning
    uint lodLevel = 0u;
    if (_EnableGpuLod != 0u)
    {
        float3 toCam = worldPos - _CameraWorldPos.xyz;
        float distSq = dot(toCam, toCam);

        if (_LodDistanceSqThresholds.z > 0.0 && distSq > _LodDistanceSqThresholds.z)
        {
            return;
        }

        lodLevel = (distSq > _LodDistanceSqThresholds.y)
            ? 2u
            : ((distSq > _LodDistanceSqThresholds.x) ? 1u : 0u);

        if (distanceThinning && lodLevel > 0u)
        {
            uint thinMask = localParticleIdx & 3u;
            if (lodLevel == 1u && thinMask == 3u)
            {
                return;
            }
            if (lodLevel == 2u && thinMask >= 2u)
            {
                return;
            }
            float boost = (lodLevel == 2u) ? 1.22 : 1.10;
            currentSize3D *= boost;
        }
    }

    // 8. Route into Per-Material Bucket x LOD Command Slot
    uint targetLodSlot = collapseLodToCmd0 ? 0u : lodLevel;
    uint cmdIndex = emitter.MaterialBucketIndex * 3u + targetLodSlot;
    if (cmdIndex >= _CommandCount)
    {
        return;
    }

    uint localSlot;
    InterlockedAdd(_IndirectArgsBuffer[cmdIndex * 5u + 1u], 1u, localSlot);
    if (localSlot >= _MaxInstancesPerCommand)
    {
        return;
    }

    // 9. Final Color, Alpha, and 3D Rotation Evaluation
    float4 startColorMin = UnpackRGBA8(emitter.StartColorMinPacked);
    float4 startColorMax = UnpackRGBA8(emitter.StartColorMaxPacked);
    float4 startColor = lerp(startColorMin, startColorMax, Hash01(cycleSeed + 29u));
    float4 finalColor = startColor * lutColor * speedColorMult;

    float rotZStart = lerp(emitter.StartRotationMin3D.z, emitter.StartRotationMaxZ, Hash01(cycleSeed + 31u));
    float rotX = startRotation3D ? (emitter.StartRotationMin3D.x + lutCurves.z * 0.5 * age) : 0.0;
    float rotY = startRotation3D ? (emitter.StartRotationMin3D.y + lutCurves.z * 0.7 * age) : 0.0;
    float rotZ = rotZStart + (lutCurves.z + rotSpeedAdd) * age;

    float ageByte = floor(normAge * 255.0);
    float clampedAlpha = clamp(finalColor.a, 0.001, 0.999);
    float packedAlphaAge = ageByte + clampedAlpha;

    uint globalSlot = cmdIndex * _MaxInstancesPerCommand + localSlot;

    GpuVisibleParticle vis;
    vis.PositionAndSizeX = float4(worldPos, currentSize3D.x);
    vis.VelocityAndRotZ = float4(worldVel, rotZ);
    vis.ColorAndAlphaAge = float4(finalColor.rgb, packedAlphaAge);
    vis.ScaleYZAndRotXY = float4(
        startSize3D ? currentSize3D.y : currentSize3D.x,
        startSize3D ? currentSize3D.z : currentSize3D.x,
        rotX,
        rotY);
    _VisibleParticlesBuffer[globalSlot] = vis;
}

// Kernel 2: Populates Unity's official unity_ParticleInstanceData (DefaultParticleInstanceData, 56B)
// at index [0 .. instanceCount - 1] so ANY unmodified Unity shader (URP/Particles/Lit, URP/Particles/Unlit,
// URP/Lit, Shader Graph, or custom user shaders) renders Billboards, Stretched Billboards, and 3D Meshes natively!
[numthreads(64, 1, 1)]
void CSBuildUnityParticleInstanceData(uint3 id : SV_DispatchThreadID)
{
    uint localIdx = id.x;
    uint visibleCount = _IndirectArgsBuffer[_SourceCommandIndex * 5u + 1u];
    if (localIdx >= visibleCount || localIdx >= _MaxInstancesPerCommand)
    {
        return;
    }

    uint globalSlot = _SourceCommandIndex * _MaxInstancesPerCommand + localIdx;
    GpuVisibleParticle part = _VisibleParticlesBuffer[globalSlot];

    float3 centerWS = part.PositionAndSizeX.xyz;
    float3 size3D = max(float3(0.001, 0.001, 0.001), float3(part.PositionAndSizeX.w, part.ScaleYZAndRotXY.x, part.ScaleYZAndRotXY.y));
    float3 velWS = part.VelocityAndRotZ.xyz;
    float rotZ = part.VelocityAndRotZ.w;
    float3 eulerRot = float3(part.ScaleYZAndRotXY.z, part.ScaleYZAndRotXY.w, rotZ);

    float3 axisX;
    float3 axisY;
    float3 axisZ;

    if (_BucketRenderShape == 0u) // Camera-Facing Billboard with 2D Z-Rotation
    {
        float3 toPart = centerWS - _CameraWorldPos.xyz;
        float dist = length(toPart);
        float3 camForward = (dist > 0.001) ? (toPart / dist) : float3(0.0, 0.0, 1.0);
        float3 upRef = (abs(camForward.y) > 0.99) ? float3(1.0, 0.0, 0.0) : float3(0.0, 1.0, 0.0);
        float3 camRight = normalize(cross(upRef, camForward));
        float3 camUp = cross(camForward, camRight);

        float s, c;
        sincos(rotZ, s, c);
        axisX = (camRight * c + camUp * s) * size3D.x;
        axisY = (-camRight * s + camUp * c) * size3D.y;
        axisZ = -camForward * size3D.x;
    }
    else if (_BucketRenderShape == 1u) // Velocity-Aligned Stretched Billboard
    {
        float3 toPart = centerWS - _CameraWorldPos.xyz;
        float dist = length(toPart);
        float3 camForward = (dist > 0.001) ? (toPart / dist) : float3(0.0, 0.0, 1.0);
        float3 upRef = (abs(camForward.y) > 0.99) ? float3(1.0, 0.0, 0.0) : float3(0.0, 1.0, 0.0);
        float3 camRight = normalize(cross(upRef, camForward));
        float3 camUp = cross(camForward, camRight);

        float speed = length(velWS);
        float3 dirWS = (speed > 0.01) ? (velWS / speed) : camUp;
        float3 planeVel = dirWS - camForward * dot(dirWS, camForward);
        float planeSpeed = length(planeVel);
        float3 stretchUp = (planeSpeed > 0.001) ? (planeVel / planeSpeed) : camUp;
        float3 stretchRight = normalize(cross(stretchUp, camForward));

        float stretchMult = max(0.05, _BucketStretchAndFlipbook.x);
        float maxStretch = max(1.0, _BucketStretchAndFlipbook.y);
        float stretchFactor = clamp(1.0 + speed * stretchMult, 1.0, maxStretch);

        axisX = stretchRight * size3D.x;
        axisY = stretchUp * (size3D.y * stretchFactor);
        axisZ = -camForward * size3D.x;
    }
    else // 3D Mesh (MeshSphere, MeshCube, or User Custom 3D Mesh with full 3D Rotation & Non-Uniform 3D Scale)
    {
        float3x3 rotMat = BuildEulerRotationMatrix3x3(eulerRot);
        axisX = rotMat[0] * size3D.x;
        axisY = rotMat[1] * size3D.y;
        axisZ = rotMat[2] * size3D.z;
    }

    float alpha = frac(part.ColorAndAlphaAge.a);
    float normAge = floor(part.ColorAndAlphaAge.a) * (1.0 / 255.0);
    float3 rgb = saturate(part.ColorAndAlphaAge.rgb);

    DefaultParticleInstanceData outInst;
    outInst.transform._11_21_31 = axisX;
    outInst.transform._12_22_32 = axisY;
    outInst.transform._13_23_33 = axisZ;
    outInst.transform._14_24_34 = centerWS;
    outInst.color = PackRGBA8(float4(rgb, alpha));
    outInst.animFrame = clamp(normAge, 0.0, 0.9999) * max(1.0, _BucketStretchAndFlipbook.z);

    _TargetUnityParticleBuffer[localIdx] = outInst;
}
